---
import '../styles/global.css';
import { languages, type SupportedLocale } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  durationSeconds?: number;
  lang?: SupportedLocale;
  cleanPath?: string;
}

const {
  title = "Meditation Timer Online | Free Minimalist Mindfulness Timer with Bells & Ambient Sounds",
  description = "A free, minimalist online meditation timer with authentic Tibetan singing bowls, customizable warm-up countdown, periodic interval chimes, and ambient nature sounds. No ads, no sign-up, screen wake lock included.",
  canonicalUrl = Astro.url.href,
  durationSeconds = 600,
  lang = 'en',
  cleanPath: customCleanPath,
} = Astro.props;

// Determine clean path without locale prefix for proper hreflang cross-linking
let cleanPath = customCleanPath;
if (!cleanPath) {
  const pathname = Astro.url.pathname;
  const pathParts = pathname.split('/').filter(Boolean);
  if (pathParts.length > 0 && ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].includes(pathParts[0])) {
    cleanPath = '/' + pathParts.slice(1).join('/');
  } else {
    cleanPath = pathname;
  }
}
if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
if (cleanPath.length > 1 && cleanPath.endsWith('/')) cleanPath = cleanPath.slice(0, -1);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Meditation Timer Online",
  "url": "https://freemeditationtimeronline.com",
  "description": description,
  "inLanguage": lang,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Customizable session duration (1 min to 3 hours)",
    "Preparation warm-up countdown",
    "Authentic Tibetan bowl & Kyoto Zen bell sounds",
    "Free ambient soundscapes (Rain, Ocean, Stream, Brown Noise)",
    "Automatic Screen Wake Lock",
    "100% Private local streak & habit tracker",
    "Zero ads, no account required"
  ]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" id="theme-color-meta" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternate Links for Multilingual SEO -->
    <link rel="alternate" hreflang="x-default" href={`https://freemeditationtimeronline.com${cleanPath === '/' ? '/' : cleanPath}`} />
    <link rel="alternate" hreflang="en" href={`https://freemeditationtimeronline.com${cleanPath === '/' ? '/' : cleanPath}`} />
    <link rel="alternate" hreflang="es" href={`https://freemeditationtimeronline.com/es${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="ja" href={`https://freemeditationtimeronline.com/ja${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="fr" href={`https://freemeditationtimeronline.com/fr${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="de" href={`https://freemeditationtimeronline.com/de${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="pt" href={`https://freemeditationtimeronline.com/pt${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="ko" href={`https://freemeditationtimeronline.com/ko${cleanPath === '/' ? '' : cleanPath}`} />
    <link rel="alternate" hreflang="it" href={`https://freemeditationtimeronline.com/it${cleanPath === '/' ? '' : cleanPath}`} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="meditation timer online, free meditation timer, mindfulness timer, tibetan singing bowl timer, meditation bell online, interval meditation timer, zen timer" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Meditation Timer Online" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Theme & Background Init Script (competitor atmospheric immersion + pure canvas support) -->
    <script is:inline>
      try {
        const localSettings = localStorage.getItem('mto_settings_v1');
        const isDark = localSettings ? JSON.parse(localSettings).darkMode === true : false;
        if (isDark) {
          document.documentElement.classList.add('dark');
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', '#121214');
        } else {
          document.documentElement.classList.remove('dark');
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', '#ffffff');
        }

        const savedBg = localStorage.getItem('currentBackgroundImage');
        if (savedBg === 'none') {
          document.documentElement.classList.remove('has-ambient-wallpaper');
        } else {
          document.documentElement.classList.add('has-ambient-wallpaper');
        }
      } catch (e) {
        document.documentElement.classList.add('has-ambient-wallpaper');
      }
    </script>
  </head>
  <body class="relative min-h-screen flex flex-col bg-white dark:bg-[#121214] text-[#1d1d1f] dark:text-[#f5f5f7] selection:bg-blue-500/20 selection:text-blue-900 dark:selection:text-blue-200 transition-colors duration-300">
    
    <!-- Atmospheric Fullscreen Background Layer (as in meditationtimer.online) -->
    <div id="ambient-bg-layer" class="fixed inset-0 z-0 pointer-events-none overflow-hidden transition-opacity duration-700">
      <img
        id="active-bg-image"
        class="w-full h-full object-cover transition-all duration-700 filter blur-[1.5px] scale-105"
        alt="Serene Background Scenery"
        src="https://images.unsplash.com/photo-1518248728743-f22e843d1f54?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
        fetchpriority="high"
      />
      <div id="bg-overlay" class="absolute inset-0 bg-black/45 dark:bg-black/65 transition-colors duration-500"></div>
    </div>

    <!-- Page Content Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <script is:inline>
      // Apply saved background image on DOM load
      try {
        const savedBg = localStorage.getItem('currentBackgroundImage');
        const bgLayer = document.getElementById('ambient-bg-layer');
        const bgImg = document.getElementById('active-bg-image');
        if (savedBg === 'none') {
          if (bgLayer) bgLayer.style.display = 'none';
        } else if (savedBg && bgImg) {
          bgImg.src = savedBg;
        }
      } catch (e) {}
    </script>
  </body>
</html>
