---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  durationSeconds?: number;
}

const {
  title = "Meditation Timer Online | Free Minimalist Mindfulness Timer with Bells & Ambient Sounds",
  description = "A free, minimalist online meditation timer with authentic Tibetan singing bowls, customizable warm-up countdown, periodic interval chimes, and ambient nature sounds. No ads, no sign-up, screen wake lock included.",
  canonicalUrl = Astro.url.href,
  durationSeconds = 600,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Meditation Timer Online",
  "url": "https://freemeditationtimeronline.com",
  "description": description,
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Customizable session duration (1 min to 3 hours)",
    "Preparation warm-up countdown",
    "Authentic Tibetan bowl & Kyoto Zen bell sounds",
    "Free ambient soundscapes (Rain, Ocean, Stream, Brown Noise)",
    "Automatic Screen Wake Lock",
    "100% Private local streak & habit tracker",
    "Zero ads, no account required"
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f5f7" id="theme-color-meta" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="meditation timer online, free meditation timer, mindfulness timer, tibetan singing bowl timer, meditation bell online, interval meditation timer, zen timer" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Meditation Timer Online" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Theme Init Script (Default Light Theme) -->
    <script is:inline>
      try {
        const localSettings = localStorage.getItem('mto_settings_v1');
        // Default strictly to Light Theme (isDark = false)
        const isDark = localSettings ? JSON.parse(localSettings).darkMode === true : false;
        if (isDark) {
          document.documentElement.classList.add('dark');
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', '#121214');
        } else {
          document.documentElement.classList.remove('dark');
          const meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', '#f5f5f7');
        }
      } catch (e) {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#f5f5f7] dark:bg-[#121214] text-[#1d1d1f] dark:text-[#f5f5f7] selection:bg-blue-500/20 selection:text-blue-900 dark:selection:text-blue-200 transition-colors duration-300">
    <slot />
  </body>
</html>
