---
import { translations, type SupportedLocale } from '../i18n/translations';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  lang?: SupportedLocale;
  faqs?: FAQItem[];
}

const { lang = 'en', faqs: customFaqs } = Astro.props;
const t = translations[lang] || translations.en;
const faqs: FAQItem[] = customFaqs || t.faqs;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": lang,
  "mainEntity": faqs.map((faq: FAQItem) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-black/[0.06] dark:border-white/[0.08]" aria-labelledby="faq-heading">
  
  <!-- Section Title -->
  <div class="text-center max-w-xl mx-auto mb-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 mb-2.5">
      {t.faqBadge}
    </div>
    <h2 id="faq-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
      {t.faqTitle}
    </h2>
    <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
      {t.faqSubtitle}
    </p>
  </div>

  <!-- Accordion List -->
  <div class="space-y-3">
    {faqs.map((item: FAQItem) => (
      <details class="group rounded-2xl bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] shadow-xs transition-all duration-200 open:shadow-sm">
        <summary class="flex items-center justify-between p-4 sm:p-5 text-left font-medium text-sm sm:text-base text-zinc-900 dark:text-white cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
          <span class="pr-4 tracking-tight">{item.question}</span>
          <span class="w-6 h-6 rounded-full bg-black/[0.04] dark:bg-white/[0.08] flex items-center justify-center text-zinc-500 group-open:rotate-180 transition-transform duration-200 shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </summary>
        <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-0 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-black/[0.04] dark:border-white/[0.04] mt-1 pt-3">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>

  <!-- JSON-LD Structured Data for Google AI Overviews & Schema FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</section>
