---
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;

const quickTimers = [
  { slug: "1-minute-meditation-timer", label: "1 Min", desc: "Mindful Reset", seconds: 60 },
  { slug: "3-minute-meditation-timer", label: "3 Mins", desc: "Quick Breathing", seconds: 180 },
  { slug: "5-minute-meditation-timer", label: "5 Mins", desc: "Daily Clarity", seconds: 300 },
  { slug: "10-minute-meditation-timer", label: "10 Mins", desc: "Classic Session", seconds: 600 },
  { slug: "15-minute-meditation-timer", label: "15 Mins", desc: "Stress Relief", seconds: 900 },
  { slug: "20-minute-meditation-timer", label: "20 Mins", desc: "Deep Stillness", seconds: 1200 },
  { slug: "25-minute-meditation-timer", label: "25 Mins", desc: "Zen Focus", seconds: 1500 },
  { slug: "30-minute-meditation-timer", label: "30 Mins", desc: "Vipassana Sit", seconds: 1800 },
  { slug: "45-minute-meditation-timer", label: "45 Mins", desc: "Extended Sit", seconds: 2700 },
  { slug: "1-hour-meditation-timer", label: "1 Hour", desc: "Retreat Depth", seconds: 3600 },
];
---

<section class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-white/[0.08]">
  
  <!-- Section Heading -->
  <div class="text-center max-w-xl mx-auto mb-10">
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-white">
      {t.quickTimersTitle}
    </h2>
    <p class="text-xs sm:text-sm text-white/50 mt-1.5">
      {t.quickTimersSubtitle}
    </p>
  </div>

  <!-- Quick Timers Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-16">
    {quickTimers.map((timer) => (
      <a
        href={lang === 'en' ? `/${timer.slug}` : `/${lang}/${timer.slug}`}
        class="group min-h-[68px] p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] hover:-translate-y-1 hover:shadow-[0_8px_25px_rgba(6,182,212,0.16)] active:scale-[0.98] border border-white/[0.06] hover:border-cyan-400/40 transition-all duration-300 text-center flex flex-col items-center justify-center relative overflow-hidden"
      >
        <div class="text-lg sm:text-xl font-bold text-white group-hover:text-cyan-400 transition-colors tabular-nums">
          {timer.label}
        </div>
        <div class="text-[11px] text-white/50 group-hover:text-white/80 transition-colors mt-0.5">
          {timer.desc}
        </div>
      </a>
    ))}
  </div>

  <!-- Feature Comparison & Value Highlights -->
  <div class="rounded-3xl bg-white/[0.02] border border-white/[0.06] p-6 sm:p-10">
    <div class="max-w-2xl mx-auto text-center mb-8">
      <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-white">
        {t.valueTitle}
      </h3>
      <p class="text-xs sm:text-sm text-white/50 mt-2">
        {t.valueSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      
      <!-- Feature 1 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mx-auto sm:mx-0">
          <svg class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">{t.feature1Title}</h4>
        <p class="text-xs text-white/50 leading-relaxed">
          {t.feature1Desc}
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto sm:mx-0">
          <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12c1.5-2 3.5-3 5.5-3s4 1 5.5 3 3.5 3 5.5 3 4-1 5.5-3"/>
            <path d="M2 18c1.5-2 3.5-3 5.5-3s4 1 5.5 3 3.5 3 5.5 3 4-1 5.5-3"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">{t.feature2Title}</h4>
        <p class="text-xs text-white/50 leading-relaxed">
          {t.feature2Desc}
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto sm:mx-0">
          <svg class="w-5 h-5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white">{t.feature3Title}</h4>
        <p class="text-xs text-white/50 leading-relaxed">
          {t.feature3Desc}
        </p>
      </div>

    </div>
  </div>

</section>
