---
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;

const quickTimers = [
  { slug: "1-minute-meditation-timer", label: "1 Min", desc: "Mindful Reset", seconds: 60 },
  { slug: "3-minute-meditation-timer", label: "3 Mins", desc: "Quick Breathing", seconds: 180 },
  { slug: "5-minute-meditation-timer", label: "5 Mins", desc: "Daily Clarity", seconds: 300 },
  { slug: "10-minute-meditation-timer", label: "10 Mins", desc: "Classic Session", seconds: 600 },
  { slug: "15-minute-meditation-timer", label: "15 Mins", desc: "Stress Relief", seconds: 900 },
  { slug: "20-minute-meditation-timer", label: "20 Mins", desc: "Deep Stillness", seconds: 1200 },
  { slug: "25-minute-meditation-timer", label: "25 Mins", desc: "Zen Focus", seconds: 1500 },
  { slug: "30-minute-meditation-timer", label: "30 Mins", desc: "Vipassana Sit", seconds: 1800 },
  { slug: "45-minute-meditation-timer", label: "45 Mins", desc: "Extended Sit", seconds: 2700 },
  { slug: "1-hour-meditation-timer", label: "1 Hour", desc: "Retreat Depth", seconds: 3600 },
];
---

<section class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 border-t border-zinc-200/80 dark:border-white/[0.08]">
  
  <!-- Section Heading -->
  <div class="text-center max-w-xl mx-auto mb-10">
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">
      {t.quickTimersTitle}
    </h2>
    <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1.5">
      {t.quickTimersSubtitle}
    </p>
  </div>

  <!-- Quick Timers Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-16">
    {quickTimers.map((timer) => (
      <a
        href={lang === 'en' ? `/${timer.slug}` : `/${lang}/${timer.slug}`}
        class="group p-4 rounded-2xl bg-zinc-50/80 hover:bg-white dark:bg-[#1c1c1e] border border-zinc-200/80 dark:border-white/[0.08] hover:border-blue-500/50 hover:shadow-md transition-all text-center flex flex-col items-center justify-center shadow-2xs"
      >
        <div class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors tabular-nums">
          {timer.label}
        </div>
        <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
          {timer.desc}
        </div>
      </a>
    ))}
  </div>

  <!-- Feature Comparison & Value Highlights -->
  <div class="rounded-3xl bg-zinc-50/60 dark:bg-[#1c1c1e] border border-zinc-200/80 dark:border-white/[0.08] p-6 sm:p-10 shadow-xs">
    <div class="max-w-2xl mx-auto text-center mb-8">
      <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 mb-3">
        {t.valueBadge}
      </div>
      <h3 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">
        {t.valueTitle}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-2">
        {t.valueSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      
      <!-- Feature 1 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-base mx-auto sm:mx-0">
          🔔
        </div>
        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">{t.feature1Title}</h4>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          {t.feature1Desc}
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-base mx-auto sm:mx-0">
          🌊
        </div>
        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">{t.feature2Title}</h4>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          {t.feature2Desc}
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="space-y-2 text-center sm:text-left">
        <div class="w-10 h-10 rounded-2xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-base mx-auto sm:mx-0">
          🔒
        </div>
        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">{t.feature3Title}</h4>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          {t.feature3Desc}
        </p>
      </div>

    </div>
  </div>

</section>
