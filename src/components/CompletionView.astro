---
// CompletionView.astro - Mindful session completion screen
---

<div id="completion-screen" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-300">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/70 sm:bg-black/80 backdrop-blur-xl"></div>

  <!-- Card -->
  <div class="relative w-full max-w-md p-6 sm:p-8 rounded-t-3xl sm:rounded-3xl bg-[#141824] text-white shadow-2xl border-t sm:border border-white/10 text-center transform translate-y-4 sm:translate-y-0 sm:scale-95 transition-transform duration-300 max-h-[90dvh] overflow-y-auto pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
    
    <!-- Mobile Pull Indicator -->
    <div class="sm:hidden -mt-3 mb-4 flex justify-center">
      <div class="w-10 h-1 rounded-full bg-white/20"></div>
    </div>

    <!-- Zen Bell Icon with subtle glow -->
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shadow-lg shadow-cyan-500/10">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </div>

    <!-- Title -->
    <h2 class="text-2xl font-semibold tracking-tight text-white mb-1">
      Meditation Complete
    </h2>
    <p class="text-sm text-white/60 mb-6">
      Take a deep breath and gently return to your day.
    </p>

    <!-- Session Stats Highlight -->
    <div class="grid grid-cols-2 gap-3 mb-6">
      <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06]">
        <div class="text-xs text-white/50">Duration</div>
        <div id="completion-duration-text" class="text-xl font-bold text-white tabular-nums mt-0.5">
          10 mins
        </div>
      </div>
      <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06]">
        <div class="text-xs text-white/50">Daily Streak</div>
        <div id="completion-streak-text" class="text-xl font-bold text-orange-400 tabular-nums mt-0.5">
          🔥 1 Day
        </div>
      </div>
    </div>

    <!-- Reflection Check-In -->
    <div class="mb-6 text-left">
      <label class="block text-xs font-semibold text-white/80 mb-2.5">
        How do you feel in this moment?
      </label>
      <div id="mood-pills-container" class="flex flex-wrap gap-2">
        <button type="button" data-mood="calm" class="mood-btn min-h-[38px] px-3.5 py-2 rounded-full text-xs font-medium border border-white/10 hover:border-cyan-400/50 bg-white/[0.03] text-white/80 transition-colors">
          Calm 🕊️
        </button>
        <button type="button" data-mood="grounded" class="mood-btn min-h-[38px] px-3.5 py-2 rounded-full text-xs font-medium border border-white/10 hover:border-cyan-400/50 bg-white/[0.03] text-white/80 transition-colors">
          Grounded 🌿
        </button>
        <button type="button" data-mood="clear" class="mood-btn min-h-[38px] px-3.5 py-2 rounded-full text-xs font-medium border border-white/10 hover:border-cyan-400/50 bg-white/[0.03] text-white/80 transition-colors">
          Clear 💡
        </button>
        <button type="button" data-mood="relaxed" class="mood-btn min-h-[38px] px-3.5 py-2 rounded-full text-xs font-medium border border-white/10 hover:border-cyan-400/50 bg-white/[0.03] text-white/80 transition-colors">
          Relaxed 🧘
        </button>
        <button type="button" data-mood="grateful" class="mood-btn min-h-[38px] px-3.5 py-2 rounded-full text-xs font-medium border border-white/10 hover:border-cyan-400/50 bg-white/[0.03] text-white/80 transition-colors">
          Grateful 🙏
        </button>
      </div>
    </div>

    <!-- Actions -->
    <div class="space-y-2.5">
      <button
        id="meditate-again-btn"
        type="button"
        class="w-full min-h-[46px] py-3 rounded-full bg-cyan-500 hover:bg-cyan-400 active:bg-cyan-600 text-black font-semibold text-sm transition-colors shadow-lg shadow-cyan-500/20"
      >
        Meditate Again
      </button>

      <button
        id="view-stats-from-completion-btn"
        type="button"
        class="w-full min-h-[42px] py-2.5 rounded-full bg-white/10 hover:bg-white/15 active:bg-white/20 text-white/80 font-medium text-xs transition-colors"
      >
        View Weekly Consistency & Log
      </button>
    </div>

  </div>
</div>
