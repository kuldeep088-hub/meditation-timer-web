---
// SoundMixerModal.astro - Apple-styled modal dialog for audio, warm-up, intervals & intentions
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;
---

<div id="settings-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-200">
  <!-- Backdrop -->
  <div id="settings-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Dialog Container -->
  <div class="relative w-full max-w-lg max-h-[88dvh] sm:max-h-[90vh] flex flex-col rounded-t-3xl sm:rounded-3xl bg-[#1c1c1e] text-white shadow-2xl border-t sm:border border-white/10 overflow-hidden transform scale-95 transition-transform duration-200 pb-[env(safe-area-inset-bottom,0px)]">
    
    <!-- Mobile Pull Indicator -->
    <div class="sm:hidden pt-2.5 pb-0.5 flex justify-center">
      <div class="w-10 h-1 rounded-full bg-white/20"></div>
    </div>

    <!-- Modal Header -->
    <div class="px-5 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between border-b border-white/[0.08]">
      <div>
        <h2 class="text-base sm:text-lg font-semibold tracking-tight text-white">{t.preferences}</h2>
        <p class="text-xs text-zinc-400">{t.preferencesSubtitle}</p>
      </div>
      <button
        id="close-settings-btn"
        type="button"
        class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 flex items-center justify-center text-zinc-300 hover:text-white transition-colors min-h-[36px] min-w-[36px] cursor-pointer touch-manipulation"
        aria-label="Close settings"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="px-4 sm:px-6 py-4 sm:py-5 overflow-y-auto overscroll-contain space-y-5 sm:space-y-6 text-sm">
      
      <!-- Section 1: Bell Sounds & Volume -->
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <label class="font-medium text-zinc-800 dark:text-zinc-200 flex items-center gap-1.5">
            <span>{t.bellSound}</span>
          </label>
          <button
            id="preview-bell-btn"
            type="button"
            class="text-xs text-cyan-400 hover:underline flex items-center gap-1 font-medium"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            {t.auditionSound}
          </button>
        </div>

        <div class="grid grid-cols-2 gap-2 mb-3">
          <button type="button" data-bell="bowl" class="bell-option-btn px-3 py-2.5 rounded-xl border border-cyan-500 bg-cyan-500/20 text-cyan-300 font-medium text-left flex items-center justify-between transition-colors">
            <div>
              <div class="font-semibold text-xs">{t.tibetanBowl}</div>
              <div class="text-[11px] opacity-75">{t.bowlSubtitle}</div>
            </div>
            <span class="bell-check text-cyan-400 font-bold text-xs">✓</span>
          </button>

          <button type="button" data-bell="zen" class="bell-option-btn px-3 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-left flex items-center justify-between transition-colors">
            <div>
              <div class="font-semibold text-xs">{t.kyotoZen}</div>
              <div class="text-[11px] text-zinc-500">{t.zenSubtitle}</div>
            </div>
            <span class="bell-check hidden font-bold text-xs">✓</span>
          </button>

          <button type="button" data-bell="gong" class="bell-option-btn px-3 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-left flex items-center justify-between transition-colors">
            <div>
              <div class="font-semibold text-xs">{t.deepGong}</div>
              <div class="text-[11px] text-zinc-500">{t.gongSubtitle}</div>
            </div>
            <span class="bell-check hidden font-bold text-xs">✓</span>
          </button>

          <button type="button" data-bell="tingsha" class="bell-option-btn px-3 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-left flex items-center justify-between transition-colors">
            <div>
              <div class="font-semibold text-xs">{t.tingsha}</div>
              <div class="text-[11px] text-zinc-500">{t.tingshaSubtitle}</div>
            </div>
            <span class="bell-check hidden font-bold text-xs">✓</span>
          </button>
        </div>

        <!-- Bell Volume Slider -->
        <div class="space-y-1.5 bg-zinc-50 dark:bg-zinc-900/60 p-3 rounded-2xl">
          <div class="flex justify-between text-xs text-zinc-600 dark:text-zinc-400">
            <span>{t.bellVolume}</span>
            <span id="bell-vol-label" class="font-medium">85%</span>
          </div>
          <input
            id="bell-volume-slider"
            type="range"
            min="0"
            max="100"
            value="85"
            class="w-full h-2 accent-cyan-500"
            aria-label="Bell Volume"
          />
        </div>
      </div>

      <!-- Section 2: Ambient Background Sounds (Free!) -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="font-medium text-zinc-800 dark:text-zinc-200">
            {t.ambientSoundscapes} <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 font-semibold uppercase">{t.freeBadge}</span>
          </label>
        </div>

        <div class="grid grid-cols-3 gap-2 mb-3">
          <button type="button" data-ambient="none" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-cyan-500 bg-cyan-500/20 text-cyan-300 text-center text-xs font-medium transition-colors">
            {t.silence}
          </button>
          <button type="button" data-ambient="rain" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-center text-xs font-medium transition-colors">
            {t.rain}
          </button>
          <button type="button" data-ambient="stream" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-center text-xs font-medium transition-colors">
            {t.stream}
          </button>
          <button type="button" data-ambient="ocean" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-center text-xs font-medium transition-colors">
            {t.ocean}
          </button>
          <button type="button" data-ambient="brown" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-center text-xs font-medium transition-colors">
            {t.brownNoise}
          </button>
          <button type="button" data-ambient="white" class="ambient-option-btn px-2.5 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 text-zinc-700 dark:text-zinc-300 text-center text-xs font-medium transition-colors">
            {t.breeze}
          </button>
        </div>

        <!-- Ambient Volume Slider -->
        <div id="ambient-vol-container" class="space-y-1.5 bg-zinc-50 dark:bg-zinc-900/60 p-3 rounded-2xl opacity-50 pointer-events-none transition-opacity">
          <div class="flex justify-between text-xs text-zinc-600 dark:text-zinc-400">
            <span>{t.ambientVolume}</span>
            <span id="ambient-vol-label" class="font-medium">50%</span>
          </div>
          <input
            id="ambient-volume-slider"
            type="range"
            min="0"
            max="100"
            value="50"
            class="w-full h-2 accent-cyan-500"
            aria-label="Ambient Volume"
          />
        </div>
      </div>

      <!-- Section 3: Warm-up Countdown & Periodic Intervals -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Warm-up -->
        <div class="space-y-1.5">
          <label for="warmup-select" class="block font-medium text-xs text-zinc-700 dark:text-zinc-300">
            {t.warmupPrep}
          </label>
          <select
            id="warmup-select"
            class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 text-xs focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
          >
            <option value="0">{t.noWarmup}</option>
            <option value="5">5s</option>
            <option value="10" selected>10s</option>
            <option value="15">15s</option>
            <option value="30">30s</option>
            <option value="60">60s</option>
          </select>
          <p class="text-[11px] text-zinc-500">{t.warmupPrepDesc}</p>
        </div>

        <!-- Interval Chime -->
        <div class="space-y-1.5">
          <label for="interval-select" class="block font-medium text-xs text-zinc-700 dark:text-zinc-300">
            {t.intervalBell}
          </label>
          <select
            id="interval-select"
            class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 text-xs focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
          >
            <option value="0" selected>{t.intervalOff}</option>
            <option value="60">{t.intervalEvery(1)}</option>
            <option value="120">{t.intervalEvery(2)}</option>
            <option value="300">{t.intervalEvery(5)}</option>
            <option value="600">{t.intervalEvery(10)}</option>
            <option value="900">{t.intervalEvery(15)}</option>
            <option value="1200">{t.intervalEvery(20)}</option>
            <option value="1800">{t.intervalEvery(30)}</option>
          </select>
          <p class="text-[11px] text-zinc-500">{t.intervalBellDesc}</p>
        </div>
      </div>

      <!-- Section 4: Visual Breath Guidance & Intention / Presenter Note -->
      <div class="space-y-3 pt-2 border-t border-black/[0.06] dark:border-white/[0.08]">
        <!-- Breathing Guide Switch -->
        <div class="flex items-center justify-between">
          <div>
            <div class="font-medium text-xs text-zinc-800 dark:text-zinc-200">{t.visualBreathPacer}</div>
            <div class="text-[11px] text-zinc-500">{t.visualBreathPacerDesc}</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="breath-guide-toggle" class="sr-only peer" checked />
            <div class="w-10 h-6 bg-zinc-200 peer-focus:outline-hidden rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-cyan-500"></div>
          </label>
        </div>

        <!-- Intention / Dyad Presenter Note -->
        <div class="space-y-1">
          <label for="intention-input" class="block font-medium text-xs text-zinc-800 dark:text-zinc-200">
            {t.intentionLabel} <span class="text-zinc-500 font-normal">({t.optionalLabel})</span>
          </label>
          <input
            id="intention-input"
            type="text"
            maxlength="120"
            placeholder={t.intentionPlaceholder}
            class="w-full px-3 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 text-xs placeholder:text-zinc-400 focus:outline-hidden focus:ring-2 focus:ring-cyan-500"
          />
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-3.5 bg-black/40 border-t border-white/[0.08] flex justify-end">
      <button
        id="save-settings-btn"
        type="button"
        class="px-6 py-2.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs transition-colors shadow-lg shadow-cyan-500/20"
      >
        {t.done}
      </button>
    </div>

  </div>
</div>
