---
import { translations, type SupportedLocale } from '../i18n/translations';
import { aiOverviewTranslations } from '../i18n/aiOverviewGuide';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;
const guide = aiOverviewTranslations[lang] || aiOverviewTranslations.en;

// Structured Schema.org Article & HowTo Data for Google AI Overviews and Search Generative Experience
const aiOverviewSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `https://freemeditationtimeronline.com${lang === 'en' ? '' : `/${lang}`}#ai-overview`,
      "headline": guide.heroTitle,
      "description": guide.heroParagraph,
      "inLanguage": lang,
      "author": {
        "@type": "Organization",
        "name": t.brand,
        "url": "https://freemeditationtimeronline.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": t.brand,
        "url": "https://freemeditationtimeronline.com"
      }
    },
    {
      "@type": "HowTo",
      "name": guide.blueprintTitle,
      "description": guide.blueprintSubtitle,
      "totalTime": "PT10M",
      "step": guide.blueprintSteps.map(step => ({
        "@type": "HowToStep",
        "position": step.number,
        "name": step.title,
        "text": step.desc
      }))
    }
  ]
};
---

<section class="w-full max-w-5xl mx-auto px-3 sm:px-6 py-10 sm:py-16 border-t border-white/[0.08]" aria-labelledby="ai-overview-title">
  
  <!-- ========================================== -->
  <!-- 1. FEATURED AI OVERVIEW / QUICK ANSWER BOX -->
  <!-- ========================================== -->
  <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-b from-cyan-950/20 via-white/[0.02] to-transparent border border-cyan-500/25 p-4 sm:p-8 md:p-10 mb-12 sm:mb-16 shadow-[0_8px_32px_rgba(6,182,212,0.08)]">
    <!-- Ambient glowing backdrop effect -->
    <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-blue-500/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <!-- AI Overview Header Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 mb-4 animate-shimmer">
        <svg class="w-3.5 h-3.5 text-cyan-300 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/>
        </svg>
        <span class="truncate">{guide.badge}</span>
      </div>

      <h2 id="ai-overview-title" class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-white mb-3 sm:mb-4">
        {guide.heroTitle}
      </h2>

      <!-- Concise Answer Paragraph for AI Synthesis & Featured Snippets -->
      <p class="text-xs sm:text-sm md:text-base text-zinc-300 leading-relaxed font-normal mb-6 sm:mb-8 max-w-4xl">
        {guide.heroParagraph}
      </p>

      <!-- Key Takeaways Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {guide.takeaways.map((takeaway, index) => {
          const colors = [
            { bg: 'bg-cyan-500/10', border: 'border-cyan-500/20', text: 'text-cyan-400' },
            { bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400' },
            { bg: 'bg-purple-500/10', border: 'border-purple-500/20', text: 'text-purple-400' },
            { bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', text: 'text-emerald-400' }
          ][index % 4];

          return (
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-cyan-400/30 transition-all">
              <div class={`w-8 h-8 rounded-xl ${colors.bg} border ${colors.border} ${colors.text} flex items-center justify-center mb-2.5`}>
                {index === 0 && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 6v6l4 2"/>
                  </svg>
                )}
                {index === 1 && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                  </svg>
                )}
                {index === 2 && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                    <path d="M12 18h.01"/>
                  </svg>
                )}
                {index === 3 && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                )}
              </div>
              <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">{takeaway.title}</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                {takeaway.desc}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 2. NEUROSCIENCE & BRAINWAVE MODULATION     -->
  <!-- ========================================== -->
  <div class="mb-12 sm:mb-16">
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        {guide.neuroTitle}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1.5">
        {guide.neuroSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
      {guide.neuroCards.map((card, index) => {
        const styles = [
          { symbol: 'α', textBadge: 'text-cyan-400', iconBg: 'bg-blue-500/10 text-blue-400' },
          { symbol: 'θ', textBadge: 'text-purple-400', iconBg: 'bg-purple-500/10 text-purple-400' },
          { symbol: 'DMN', textBadge: 'text-emerald-400', iconBg: 'bg-emerald-500/10 text-emerald-400' }
        ][index % 3];

        return (
          <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-cyan-400/30 transition-all">
            <div class={`w-8 h-8 rounded-xl ${styles.iconBg} font-bold flex items-center justify-center text-xs mb-3`}>
              {styles.symbol}
            </div>
            <h4 class="text-sm font-semibold text-white mb-1">{card.title}</h4>
            <div class={`text-[11px] ${styles.textBadge} font-medium mb-2`}>{card.phase}</div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {card.desc}
            </p>
          </div>
        );
      })}
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 3. MEDITATION DURATION BENCHMARK TABLE    -->
  <!-- ========================================== -->
  <div class="rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/[0.06] p-4 sm:p-8 md:p-10 mb-12 sm:mb-16 overflow-hidden">
    <div class="max-w-2xl mx-auto text-center mb-6 sm:mb-8">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        {guide.matrixTitle}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        {guide.matrixSubtitle}
      </p>
    </div>

    <!-- Responsive Table with horizontal scroll on small devices -->
    <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
      <table class="w-full min-w-[500px] text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-white/[0.08] text-zinc-400 font-medium">
            <th class="py-3 px-3 sm:px-4">{guide.matrixHeaders.duration}</th>
            <th class="py-3 px-3 sm:px-4">{guide.matrixHeaders.focus}</th>
            <th class="py-3 px-3 sm:px-4 hidden sm:table-cell">{guide.matrixHeaders.brainState}</th>
            <th class="py-3 px-3 sm:px-4">{guide.matrixHeaders.benefit}</th>
            <th class="py-3 px-3 sm:px-4 text-right">{guide.matrixHeaders.preset}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.04] text-zinc-300">
          {guide.matrixRows.map((row) => (
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">{row.duration}</td>
              <td class="py-3.5 px-3 sm:px-4">{row.focus}</td>
              <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">{row.brainState}</td>
              <td class="py-3.5 px-3 sm:px-4 text-zinc-400">{row.benefit}</td>
              <td class="py-3.5 px-3 sm:px-4 text-right">
                <a
                  href={lang === 'en' ? `/${row.timerSlug}` : `/${lang}/${row.timerSlug}`}
                  class="text-xs text-cyan-400 hover:underline"
                >
                  {row.timerLabel} →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 4. ACOUSTIC SCIENCE: BELLS & OVERTONES     -->
  <!-- ========================================== -->
  <div class="mb-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        {guide.acousticTitle}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        {guide.acousticSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {guide.bells.map((bell, index) => {
        const styles = [
          { bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400', hover: 'hover:border-amber-400/30' },
          { bg: 'bg-cyan-500/10', border: 'border-cyan-500/20', text: 'text-cyan-400', hover: 'hover:border-cyan-400/30' },
          { bg: 'bg-blue-500/10', border: 'border-blue-500/20', text: 'text-blue-400', hover: 'hover:border-blue-400/30' },
          { bg: 'bg-rose-500/10', border: 'border-rose-500/20', text: 'text-rose-400', hover: 'hover:border-rose-400/30' }
        ][index % 4];

        return (
          <div class={`p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] ${styles.hover} transition-all`}>
            <div class={`w-8 h-8 rounded-xl ${styles.bg} border ${styles.border} ${styles.text} flex items-center justify-center mb-2.5`}>
              {index === 0 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10a8 8 0 0 0 16 0H4Z"/>
                  <path d="M12 18v3"/>
                  <path d="M8 21h8"/>
                </svg>
              )}
              {index === 1 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                </svg>
              )}
              {index === 2 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              )}
              {index === 3 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/>
                </svg>
              )}
            </div>
            <h4 class="text-sm font-semibold text-white mb-1">{bell.title}</h4>
            <div class={`text-[11px] ${styles.text} font-mono mb-2`}>{bell.freq}</div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {bell.desc}
            </p>
          </div>
        );
      })}
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 5. 5-STEP UNGUIDED PRACTICE BLUEPRINT     -->
  <!-- ========================================== -->
  <div class="rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/[0.06] p-4 sm:p-8 md:p-10">
    <div class="max-w-2xl mx-auto text-center mb-8 sm:mb-10">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        {guide.blueprintTitle}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        {guide.blueprintSubtitle}
      </p>
    </div>

    <div class="space-y-4 max-w-3xl mx-auto">
      {guide.blueprintSteps.map((step) => (
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <span class="w-8 h-8 rounded-full bg-cyan-500/10 border border-cyan-400/20 text-cyan-400 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
            {step.number}
          </span>
          <div>
            <h4 class="text-sm font-semibold text-white">{step.title}</h4>
            <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- JSON-LD Structured Data for Google AI Overviews & Schema Search Engine Crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify(aiOverviewSchema)} />

</section>
