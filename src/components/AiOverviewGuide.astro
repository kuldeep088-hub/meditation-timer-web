---
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;

// Structured Schema.org Article & HowTo Data for Google AI Overviews and Search Generative Experience
const aiOverviewSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://freemeditationtimeronline.com/#ai-overview",
      "headline": "Online Meditation Timer: Complete Scientific Guide to Unguided Mindfulness Practice",
      "description": "Comprehensive guide on online meditation timers, harmonic acoustic bells, the neuroscience of unguided stillness, optimal session durations, and evidence-based breathing cadences.",
      "inLanguage": lang,
      "author": {
        "@type": "Organization",
        "name": "Meditation Timer Online",
        "url": "https://freemeditationtimeronline.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Meditation Timer Online",
        "url": "https://freemeditationtimeronline.com"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Structure an Unguided Meditation Session with an Online Timer",
      "description": "A 5-step evidence-based blueprint for deep mindfulness using authentic bells and interval chimes.",
      "totalTime": "PT10M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Establish a Relaxed, Dignified Posture",
          "text": "Sit comfortably on a cushion or chair with an upright spine, shoulders relaxed away from the ears, and hands resting gently in your lap."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Set a Preparation Countdown",
          "text": "Configure a 10 to 30 second warm-up countdown. This vital psychological buffer lets you close your eyes and transition smoothly from digital rushing to physical stillness."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Anchor Awareness on the Natural Breath",
          "text": "Rest attention on the physical sensation of the breath—the cool air at the nostrils, the rise of the chest, or the expansion of the abdomen."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Utilize Interval Bells for Gentle Re-centering",
          "text": "Enable subtle 5-minute periodic interval chimes to awaken attention from mind-wandering without needing to look at a screen."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Acknowledge Completion and Reflect",
          "text": "When the final Tibetan singing bowl chimes, sit in stillness for 30 seconds before opening your eyes. Log your mood or gratitude to reinforce your habit streak."
        }
      ]
    }
  ]
};
---

<section class="w-full max-w-5xl mx-auto px-3 sm:px-6 py-10 sm:py-16 border-t border-white/[0.08]" aria-labelledby="ai-overview-title">
  
  <!-- ========================================== -->
  <!-- 1. FEATURED AI OVERVIEW / QUICK ANSWER BOX -->
  <!-- ========================================== -->
  <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-b from-cyan-950/20 via-white/[0.02] to-transparent border border-cyan-500/25 p-4 sm:p-8 md:p-10 mb-12 sm:mb-16 shadow-[0_8px_32px_rgba(6,182,212,0.08)]">
    <!-- Ambient glowing backdrop effect -->
    <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-blue-500/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <!-- AI Overview Header Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 mb-4 animate-shimmer">
        <svg class="w-3.5 h-3.5 text-cyan-300 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/>
        </svg>
        <span class="truncate">AI Overview · Quick Reference Guide</span>
      </div>

      <h2 id="ai-overview-title" class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-white mb-3 sm:mb-4">
        What is an Online Meditation Timer & Why Practice Unguided?
      </h2>

      <!-- Concise Answer Paragraph for AI Synthesis & Featured Snippets -->
      <p class="text-xs sm:text-sm md:text-base text-zinc-300 leading-relaxed font-normal mb-6 sm:mb-8 max-w-4xl">
        An <strong class="text-white font-semibold">online meditation timer</strong> is a minimalist web utility equipped with authentic acoustic bells (such as Tibetan singing bowls and Kyoto Zen temple gongs) designed to anchor unguided mindfulness practice. Unlike voice-guided meditation apps that demand continuous auditory interpretation, unguided meditation timers cultivate intrinsic attention, quiet the brain’s Default Mode Network (DMN), and stimulate parasympathetic vagal relaxation. Key technical requirements include physical modeling audio synthesis, screen wake lock support, customizable warm-up buffers, periodic interval bells, and zero-ad local privacy.
      </p>

      <!-- Key Takeaways Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-cyan-400/30 transition-all">
          <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">Pure Unguided Stillness</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Eliminates narrator voice fatigue. Encourages internal emotional self-reliance and organic present-moment awareness.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-cyan-400/30 transition-all">
          <div class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">Harmonic Overtones</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Synthesized 216 Hz & 432 Hz resonance transitions brainwaves from high-stress Beta into relaxed Alpha/Theta states.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-cyan-400/30 transition-all">
          <div class="w-8 h-8 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">Hardware Screen Lock</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Utilizes the HTML5 Screen Wake Lock API to prevent smartphones and laptops from sleeping during prolonged sits.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] hover:border-cyan-400/30 transition-all">
          <div class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-2.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-1">100% Client Privacy</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Zero telemetry, zero logins, zero database profiling. Habit streaks and reflections remain exclusively on your device.
          </p>
        </div>
      </div>
    </div>
  </div>


  <!-- ========================================== -->
  <!-- 2. INTERACTIVE BREATHWORK PACER WIDGET    -->
  <!-- ========================================== -->
  <div class="rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/[0.06] p-4 sm:p-8 md:p-10 mb-12 sm:mb-16">
    <div class="text-center max-w-xl mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mb-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/>
          <path d="M9.6 4.6A2 2 0 1 1 11 8H2"/>
          <path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>
        </svg>
        <span>Interactive Mindfulness Tool</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        Evidence-Based Breathwork Pacer
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Select a scientifically validated cadence below to calm your nervous system before or during your meditation.
      </p>
    </div>

    <!-- Breathwork Mode Selector Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mb-6 sm:mb-8">
      <button
        type="button"
        id="cadence-btn-478"
        class="cadence-btn active px-3 sm:px-4 py-2 min-h-[40px] rounded-xl text-xs font-semibold bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 transition-all touch-manipulation cursor-pointer"
        data-cadence="4-7-8"
      >
        4-7-8 Relaxing Breath
      </button>
      <button
        type="button"
        id="cadence-btn-box"
        class="cadence-btn px-3 sm:px-4 py-2 min-h-[40px] rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-zinc-300 transition-all touch-manipulation cursor-pointer"
        data-cadence="box"
      >
        Box Breathing (4-4-4-4)
      </button>
      <button
        type="button"
        id="cadence-btn-coherent"
        class="cadence-btn px-3 sm:px-4 py-2 min-h-[40px] rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-zinc-300 transition-all touch-manipulation cursor-pointer"
        data-cadence="coherent"
      >
        Coherent (5.5s / 5.5s)
      </button>
    </div>

    <!-- Breath Visualizer Circle Card -->
    <div class="flex flex-col items-center justify-center text-center p-4 sm:p-8 rounded-2xl bg-black/40 border border-white/[0.06] max-w-md mx-auto relative overflow-hidden">
      <!-- Expanding & Contracting Breath Ring -->
      <div class="relative w-44 h-44 sm:w-52 sm:h-52 flex items-center justify-center my-4">
        <!-- Background Halo -->
        <div id="interactive-breath-halo" class="absolute inset-0 rounded-full bg-emerald-500/10 blur-xl transition-all duration-1000 scale-90"></div>
        
        <!-- Ripple Rings -->
        <div id="interactive-breath-ring" class="w-36 h-36 sm:w-44 sm:h-44 rounded-full border-2 border-emerald-400/30 flex flex-col items-center justify-center transition-all duration-1000 transform">
          <span id="interactive-breath-action" class="text-sm sm:text-base font-bold uppercase tracking-widest text-emerald-300 transition-opacity">
            Inhale
          </span>
          <span id="interactive-breath-count" class="text-2xl sm:text-3xl font-light text-white tabular-nums mt-1">
            4
          </span>
        </div>
      </div>

      <!-- Pattern Description -->
      <div id="interactive-cadence-desc" class="text-xs text-zinc-400 mt-2 max-w-xs leading-relaxed">
        <strong>Dr. Andrew Weil's 4-7-8 Technique</strong>: Inhale for 4s, gently hold for 7s, exhale completely for 8s. Naturally triggers parasympathetic vagus nerve sedation.
      </div>

      <!-- Toggle Breathing Button -->
      <button
        type="button"
        id="toggle-interactive-breath-btn"
        class="mt-6 px-6 py-2.5 min-h-[44px] rounded-full bg-emerald-500/20 hover:bg-emerald-500/30 active:scale-95 border border-emerald-400/40 text-emerald-300 text-xs font-semibold uppercase tracking-wider transition-all touch-manipulation cursor-pointer"
      >
        Pause Exercise
      </button>
    </div>
  </div>


  <!-- ========================================== -->
  <!-- 3. NEUROSCIENCE & BRAINWAVE MODULATION     -->
  <!-- ========================================== -->
  <div class="mb-12 sm:mb-16">
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        The Neuroscience of Timed Stillness
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1.5">
        How unguided meditation shifts brainwave frequencies and downregulates the sympathetic nervous system.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
      
      <!-- Card 1 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-cyan-400/30 transition-all">
        <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-400 font-bold flex items-center justify-center text-xs mb-3">
          α
        </div>
        <h4 class="text-sm font-semibold text-white mb-1">Alpha Waves (8–12 Hz)</h4>
        <div class="text-[11px] text-cyan-400 font-medium mb-2">Reached after 5–10 Minutes</div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Transitions the brain out of anxious, high-frequency Beta chatter (13–30 Hz) into relaxed alertness. Enhances neurochemical calm while maintaining lucid, non-drowsy awareness.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-400/30 transition-all">
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 font-bold flex items-center justify-center text-xs mb-3">
          θ
        </div>
        <h4 class="text-sm font-semibold text-white mb-1">Theta Synchrony (4–8 Hz)</h4>
        <div class="text-[11px] text-purple-400 font-medium mb-2">Deep Sits (15–30+ Minutes)</div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          The contemplative state associated with monk-level zazen and Vipassana. Deep emotional integration, creative insight breakthroughs, and profound bodily stillness occur here.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-emerald-400/30 transition-all">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-400 font-bold flex items-center justify-center text-xs mb-3">
          DMN
        </div>
        <h4 class="text-sm font-semibold text-white mb-1">Default Mode Network Quietude</h4>
        <div class="text-[11px] text-emerald-400 font-medium mb-2">Neurological Reset</div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Deactivates the brain's internal rumination network responsible for ego defense, past regrets, and future catastrophic projection. Strengthens executive dorsolateral prefrontal control.
        </p>
      </div>

    </div>
  </div>


  <!-- ========================================== -->
  <!-- 4. MEDITATION DURATION BENCHMARK TABLE    -->
  <!-- ========================================== -->
  <div class="rounded-2xl sm:rounded-3xl bg-white/[0.02] border border-white/[0.06] p-4 sm:p-8 md:p-10 mb-12 sm:mb-16 overflow-hidden">
    <div class="max-w-2xl mx-auto text-center mb-6 sm:mb-8">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        Meditation Duration Benchmark Guide
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Choose your session length according to your daily objective and autonomic nervous system goals.
      </p>
    </div>

    <!-- Responsive Table with horizontal scroll on small devices -->
    <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
      <table class="w-full min-w-[500px] text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-white/[0.08] text-zinc-400 font-medium">
            <th class="py-3 px-3 sm:px-4">Duration</th>
            <th class="py-3 px-3 sm:px-4">Practice Focus</th>
            <th class="py-3 px-3 sm:px-4 hidden sm:table-cell">Brain State</th>
            <th class="py-3 px-3 sm:px-4">Physiological Benefit</th>
            <th class="py-3 px-3 sm:px-4 text-right">Quick Preset</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.04] text-zinc-300">
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">1–3 Minutes</td>
            <td class="py-3.5 px-3 sm:px-4">Micro-Reset & Reset Breaths</td>
            <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">High Beta → Mid Beta</td>
            <td class="py-3.5 px-3 sm:px-4 text-zinc-400">Halts acute cortisol spikes during work sprints</td>
            <td class="py-3.5 px-3 sm:px-4 text-right">
              <a href={lang === 'en' ? "/1-minute-meditation-timer" : `/${lang}/1-minute-meditation-timer`} class="text-xs text-cyan-400 hover:underline">1m Timer →</a>
            </td>
          </tr>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">5 Minutes</td>
            <td class="py-3.5 px-3 sm:px-4">Habit Continuity & Morning Grounding</td>
            <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">Early Alpha Onset</td>
            <td class="py-3.5 px-3 sm:px-4 text-zinc-400">Builds unbreakable neuroplastic daily habits</td>
            <td class="py-3.5 px-3 sm:px-4 text-right">
              <a href={lang === 'en' ? "/5-minute-meditation-timer" : `/${lang}/5-minute-meditation-timer`} class="text-xs text-cyan-400 hover:underline">5m Timer →</a>
            </td>
          </tr>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">10 Minutes</td>
            <td class="py-3.5 px-3 sm:px-4">Classic Daily Baseline Practice</td>
            <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">Sustained Alpha Waves</td>
            <td class="py-3.5 px-3 sm:px-4 text-zinc-400">Scientifically proven to lower blood pressure and stress</td>
            <td class="py-3.5 px-3 sm:px-4 text-right">
              <a href={lang === 'en' ? "/10-minute-meditation-timer" : `/${lang}/10-minute-meditation-timer`} class="text-xs text-cyan-400 hover:underline">10m Timer →</a>
            </td>
          </tr>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">15–20 Minutes</td>
            <td class="py-3.5 px-3 sm:px-4">Vipassana, Zazen & TM Standard</td>
            <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">Alpha–Theta Boundary</td>
            <td class="py-3.5 px-3 sm:px-4 text-zinc-400">Activates profound parasympathetic vagal recovery</td>
            <td class="py-3.5 px-3 sm:px-4 text-right">
              <a href={lang === 'en' ? "/20-minute-meditation-timer" : `/${lang}/20-minute-meditation-timer`} class="text-xs text-cyan-400 hover:underline">20m Timer →</a>
            </td>
          </tr>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3.5 px-3 sm:px-4 font-bold text-white whitespace-nowrap">30–60 Minutes</td>
            <td class="py-3.5 px-3 sm:px-4">Extended Monastery & Insight Retreat</td>
            <td class="py-3.5 px-3 sm:px-4 text-cyan-400 hidden sm:table-cell">Deep Theta & Gamma</td>
            <td class="py-3.5 px-3 sm:px-4 text-zinc-400">Deep emotional equanimity and metacognitive spaciousness</td>
            <td class="py-3.5 px-3 sm:px-4 text-right">
              <a href={lang === 'en' ? "/30-minute-meditation-timer" : `/${lang}/30-minute-meditation-timer`} class="text-xs text-cyan-400 hover:underline">30m Timer →</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>


  <!-- ========================================== -->
  <!-- 5. ACOUSTIC SCIENCE: BELLS & OVERTONES     -->
  <!-- ========================================== -->
  <div class="mb-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
        Acoustic Science: Why Authentic Bowls Over Digital Beeps?
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Synthetic square-wave phone alarms trigger acute startle reflexes and adrenaline surges.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-amber-400/30 transition-all">
        <div class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-2.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 10a8 8 0 0 0 16 0H4Z"/>
            <path d="M12 18v3"/>
            <path d="M8 21h8"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white mb-1">Tibetan Singing Bowl</h4>
        <div class="text-[11px] text-amber-400 font-mono mb-2">216 Hz Fundamental</div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Rich physical modeling overtones with warm 7.5-second decay. Mimics bronze hand-hammered metallurgy to gently bathe auditory pathways.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-cyan-400/30 transition-all">
        <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mb-2.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
          </svg>
        </div>
        <h4 class="text-sm font-semibold text-white mb-1">Kyoto Zen Bell</h4>
