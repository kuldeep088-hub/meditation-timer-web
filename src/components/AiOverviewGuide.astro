<!-- Client-side script for interactive breathwork pacer -->
<script>
  function initInteractivePacer() {
    const ring = document.getElementById('interactive-breath-ring');
    const halo = document.getElementById('interactive-breath-halo');
    const actionEl = document.getElementById('interactive-breath-action');
    const countEl = document.getElementById('interactive-breath-count');
    const descEl = document.getElementById('interactive-cadence-desc');
    const toggleBtn = document.getElementById('toggle-interactive-breath-btn');
    const cadenceButtons = document.querySelectorAll('.cadence-btn');

    if (!ring || !actionEl || !countEl || !toggleBtn) return;

    type CadenceType = '4-7-8' | 'box' | 'coherent';
    let currentCadence: CadenceType = '4-7-8';
    let isRunning = true;
    let timerId: number | null = null;
    let phaseIndex = 0;
    let countdown = 4;

    const cadences = {
      '4-7-8': {
        desc: '<strong>Dr. Andrew Weil 4-7-8 Technique</strong>: Inhale 4s, gently hold 7s, exhale 8s. Naturally stimulates the vagus nerve and downregulates evening cortisol.',
        phases: [
          { name: 'Inhale', duration: 4, scale: 'scale-110', haloScale: 'scale-125', color: 'text-emerald-300' },
          { name: 'Hold', duration: 7, scale: 'scale-110', haloScale: 'scale-125', color: 'text-cyan-300' },
          { name: 'Exhale', duration: 8, scale: 'scale-85', haloScale: 'scale-90', color: 'text-blue-300' }
        ]
      },
      'box': {
        desc: '<strong>Navy SEAL Box Breathing (4-4-4-4)</strong>: Inhale 4s, hold 4s, exhale 4s, hold 4s. Instantly stabilizes physiological composure during high mental stress.',
        phases: [
          { name: 'Inhale', duration: 4, scale: 'scale-110', haloScale: 'scale-125', color: 'text-emerald-300' },
          { name: 'Hold', duration: 4, scale: 'scale-110', haloScale: 'scale-125', color: 'text-cyan-300' },
          { name: 'Exhale', duration: 4, scale: 'scale-85', haloScale: 'scale-90', color: 'text-blue-300' },
          { name: 'Hold', duration: 4, scale: 'scale-85', haloScale: 'scale-90', color: 'text-purple-300' }
        ]
      },
      'coherent': {
        desc: '<strong>Resonant Coherent Breathing (5.5s)</strong>: 5.5s inhale, 5.5s exhale (5.5 breaths/min). Optimizes Heart Rate Variability (HRV) and synchronizes cardiovascular rhythm.',
        phases: [
          { name: 'Inhale', duration: 5, scale: 'scale-110', haloScale: 'scale-125', color: 'text-emerald-300' },
          { name: 'Exhale', duration: 5, scale: 'scale-85', haloScale: 'scale-90', color: 'text-blue-300' }
        ]
      }
    };

    function startCycle() {
      if (timerId) clearInterval(timerId);
      const conf = cadences[currentCadence];
      const curPhase = conf.phases[phaseIndex];
      countdown = curPhase.duration;
      actionEl.textContent = curPhase.name;
      actionEl.className = `text-sm sm:text-base font-bold uppercase tracking-widest ${curPhase.color} transition-colors`;
      countEl.textContent = String(countdown);

      ring.className = `w-36 h-36 sm:w-44 sm:h-44 rounded-full border-2 border-emerald-400/30 flex flex-col items-center justify-center transition-all duration-[${curPhase.duration}s] transform ${curPhase.scale}`;
      halo.className = `absolute inset-0 rounded-full bg-emerald-500/10 blur-xl transition-all duration-[${curPhase.duration}s] ${curPhase.haloScale}`;

      timerId = window.setInterval(() => {
        countdown--;
        if (countdown > 0) {
          countEl.textContent = String(countdown);
        } else {
          // Advance phase
          phaseIndex = (phaseIndex + 1) % conf.phases.length;
          startCycle();
        }
      }, 1000);
    }

    startCycle();

    // Toggle Button
    toggleBtn.addEventListener('click', () => {
      isRunning = !isRunning;
      if (isRunning) {
        toggleBtn.textContent = 'Pause Exercise';
        startCycle();
      } else {
        toggleBtn.textContent = 'Resume Exercise';
        if (timerId) clearInterval(timerId);
      }
    });

    // Cadence Button Switcher
    cadenceButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cad = (btn as HTMLElement).dataset.cadence as CadenceType;
        if (!cad || !cadences[cad]) return;
        currentCadence = cad;

        cadenceButtons.forEach(b => {
          b.classList.remove('bg-emerald-500/20', 'border-emerald-400/40', 'text-emerald-300');
          b.classList.add('bg-white/[0.04]', 'border-white/[0.08]', 'text-zinc-300');
        });

        btn.classList.add('bg-emerald-500/20', 'border-emerald-400/40', 'text-emerald-300');
        btn.classList.remove('bg-white/[0.04]', 'border-white/[0.08]', 'text-zinc-300');

        if (descEl) descEl.innerHTML = cadences[cad].desc;
        phaseIndex = 0;
        if (isRunning) startCycle();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractivePacer);
  } else {
    initInteractivePacer();
  }
</script>
