---
// BackgroundModal.astro - Wallpaper selection & custom background upload
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;
---

<div id="bg-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-200">
  <!-- Backdrop -->
  <div id="bg-modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Container -->
  <div class="relative w-full max-w-lg max-h-[85dvh] sm:max-h-[90vh] flex flex-col rounded-t-3xl sm:rounded-3xl bg-[#1c1c1e] text-white shadow-2xl border border-white/10 overflow-hidden transform scale-95 transition-transform duration-200 pb-[env(safe-area-inset-bottom,0px)]">
    
    <!-- Modal Header -->
    <div class="px-5 sm:px-6 py-4 flex items-center justify-between border-b border-white/[0.08]">
      <div class="flex items-center gap-2">
        <span class="text-lg">🌄</span>
        <div>
          <h2 class="text-base sm:text-lg font-semibold tracking-tight text-white">{t.backgroundModalTitle}</h2>
          <p class="text-xs text-zinc-400">Choose scenery or upload your own photo</p>
        </div>
      </div>
      <button
        id="close-bg-modal-btn"
        type="button"
        class="w-8 h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 flex items-center justify-center text-zinc-300 hover:text-white transition-colors min-h-[36px] min-w-[36px]"
        aria-label="Close background selector"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="px-6 py-5 overflow-y-auto space-y-5 text-sm">
      
      <!-- Preset Atmospheric Sceneries -->
      <div>
        <label class="block font-medium text-xs text-zinc-700 dark:text-zinc-300 mb-2.5">
          Curated Serene Wallpapers
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="bg-presets-grid">
          <!-- 1. Misty Forest -->
          <button
            type="button"
            data-bg-url="https://images.unsplash.com/photo-1518248728743-f22e843d1f54?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-transparent hover:border-blue-500 focus:outline-hidden transition-all text-left"
          >
            <img src="https://images.unsplash.com/photo-1518248728743-f22e843d1f54?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=400" alt="Misty Forest" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-2">
              <span class="text-[11px] font-semibold text-white drop-shadow-xs">Misty Forest</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>

          <!-- 2. Calm Ocean -->
          <button
            type="button"
            data-bg-url="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-transparent hover:border-blue-500 focus:outline-hidden transition-all text-left"
          >
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=400" alt="Calm Ocean" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-2">
              <span class="text-[11px] font-semibold text-white drop-shadow-xs">Ocean Solitude</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>

          <!-- 3. Mountain Dawn -->
          <button
            type="button"
            data-bg-url="https://images.unsplash.com/photo-1519945302083-c274aa26c627?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-transparent hover:border-blue-500 focus:outline-hidden transition-all text-left"
          >
            <img src="https://images.unsplash.com/photo-1519945302083-c274aa26c627?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=400" alt="Mountain Lake" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-2">
              <span class="text-[11px] font-semibold text-white drop-shadow-xs">Alpine Lake</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>

          <!-- 4. Cosmic Night -->
          <button
            type="button"
            data-bg-url="https://images.unsplash.com/photo-1509599589979-3b5a15d2816e?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-transparent hover:border-blue-500 focus:outline-hidden transition-all text-left"
          >
            <img src="https://images.unsplash.com/photo-1509599589979-3b5a15d2816e?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=400" alt="Cosmic Sky" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-2">
              <span class="text-[11px] font-semibold text-white drop-shadow-xs">Starlit Cosmos</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>

          <!-- 5. Zen Pines -->
          <button
            type="button"
            data-bg-url="https://images.unsplash.com/photo-1511497584788-876760111969?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=1920"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-transparent hover:border-blue-500 focus:outline-hidden transition-all text-left"
          >
            <img src="https://images.unsplash.com/photo-1511497584788-876760111969?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=80&w=400" alt="Zen Pines" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-2">
              <span class="text-[11px] font-semibold text-white drop-shadow-xs">Zen Pines</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>

          <!-- 6. Pure Minimal Dark Canvas -->
          <button
            type="button"
            data-bg-url="none"
            class="bg-preset-btn group relative rounded-2xl overflow-hidden aspect-video border-2 border-zinc-800 hover:border-cyan-500 focus:outline-hidden transition-all text-left bg-zinc-900 flex items-center justify-center"
          >
            <div class="text-center p-2">
              <span class="text-xl block mb-0.5">🖤</span>
              <span class="text-[11px] font-semibold text-zinc-300">Clean Dark Canvas</span>
            </div>
            <span class="bg-check-mark absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-cyan-500 text-white flex items-center justify-center text-[10px] font-bold shadow-xs hidden">✓</span>
          </button>
        </div>
      </div>

      <!-- Upload Custom Background Image -->
      <div class="p-4 rounded-2xl bg-white/[0.04] border border-white/[0.06] space-y-2">
        <div class="flex items-center justify-between">
          <label for="bg-upload-file" class="font-medium text-xs text-white flex items-center gap-1.5 cursor-pointer">
            <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
            <span>{t.customPhotoUpload}</span>
          </label>
          <label for="bg-upload-file" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-cyan-500 hover:bg-cyan-400 text-black cursor-pointer transition-colors shadow-2xs">
            Browse...
          </label>
        </div>
        <p class="text-[11px] text-white/50">Supports JPG, PNG, WebP up to 10MB. Stored locally in your browser.</p>
        <input type="file" id="bg-upload-file" accept="image/*" class="sr-only" />
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-3.5 bg-black/40 border-t border-white/[0.08] flex items-center justify-between">
      <button
        id="randomize-bg-btn"
        type="button"
        class="text-xs text-cyan-400 hover:underline flex items-center gap-1 font-medium"
      >
        <span>🎲 Random Wallpaper</span>
      </button>
      <button
        id="save-bg-modal-btn"
        type="button"
        class="px-6 py-2.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs transition-colors shadow-lg shadow-cyan-500/20"
      >
        {t.done}
      </button>
    </div>

  </div>
</div>
