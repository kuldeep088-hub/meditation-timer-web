---
// StatsDrawer.astro - Apple Health-inspired mindful habit & streak dashboard
import { translations, type SupportedLocale } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;
---

<div id="stats-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6 opacity-0 pointer-events-none transition-all duration-200">
  <!-- Backdrop -->
  <div id="stats-backdrop" class="absolute inset-0 bg-black/60 sm:bg-black/80 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Container -->
  <div class="relative w-full max-w-lg max-h-[88dvh] sm:max-h-[90vh] flex flex-col rounded-t-3xl sm:rounded-3xl bg-[#141824] text-white shadow-2xl border-t sm:border border-white/10 overflow-hidden transform translate-y-4 sm:translate-y-0 sm:scale-95 transition-transform duration-200 pb-[env(safe-area-inset-bottom,0px)]">
    
    <!-- Mobile Pull Indicator -->
    <div class="sm:hidden pt-2.5 pb-0.5 flex justify-center">
      <div class="w-10 h-1 rounded-full bg-white/20"></div>
    </div>

    <!-- Header -->
    <div class="px-5 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between border-b border-white/[0.08]">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-full bg-amber-500/15 border border-amber-500/30 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-amber-500 fill-amber-500/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-semibold tracking-tight text-white">{t.statsTitle}</h2>
          <p class="text-[11px] sm:text-xs text-white/50">{t.statsSubtitle}</p>
        </div>
      </div>
      <button
        id="close-stats-btn"
        type="button"
        class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-white/10 hover:bg-white/15 active:bg-white/20 flex items-center justify-center text-white/70 hover:text-white transition-colors"
        aria-label="Close stats"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="px-6 py-5 overflow-y-auto space-y-6">
      
      <!-- Top 4 Stats Metric Tiles -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06] text-center">
          <div id="stat-current-streak" class="text-2xl font-bold tracking-tight text-orange-400 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-white/50 mt-0.5">{t.dayStreak}</div>
        </div>

        <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06] text-center">
          <div id="stat-longest-streak" class="text-2xl font-bold tracking-tight text-white tabular-nums">0</div>
          <div class="text-[11px] font-medium text-white/50 mt-0.5">{t.bestStreak}</div>
        </div>

        <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06] text-center">
          <div id="stat-total-sessions" class="text-2xl font-bold tracking-tight text-cyan-400 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-white/50 mt-0.5">{t.sessions}</div>
        </div>

        <div class="bg-white/[0.04] p-3.5 rounded-2xl border border-white/[0.06] text-center">
          <div id="stat-total-minutes" class="text-2xl font-bold tracking-tight text-emerald-400 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-white/50 mt-0.5">{t.minutes}</div>
        </div>
      </div>

      <!-- 7-Day Activity Rhythm -->
      <div class="bg-white/[0.04] p-4 rounded-2xl border border-white/[0.06]">
        <div class="text-xs font-semibold text-white/80 mb-3 flex items-center justify-between">
          <span>{t.weeklyRhythm}</span>
          <span class="text-[11px] font-normal text-white/40">{t.last7Days}</span>
        </div>
        <div id="week-dots-container" class="grid grid-cols-7 gap-2 text-center">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- Recent Sessions Log -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-white/80">{t.recentSessions}</span>
          <span class="text-[11px] text-white/40" id="sessions-count-label">0 recorded</span>
        </div>

        <div id="recent-sessions-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
          <!-- Dynamically populated or empty state -->
          <div class="text-center py-6 text-white/40 text-xs">
            No completed sessions yet. Start your first practice today!
          </div>
        </div>
      </div>

      <!-- Privacy & Data Controls -->
      <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-xs text-white/40">
        <span class="text-[11px]">No login required · No telemetry</span>
        <div class="flex gap-3">
          <button id="export-data-btn" type="button" class="py-1.5 px-2 hover:text-cyan-400 text-white/60 underline transition-colors min-h-[36px] flex items-center">
            {t.exportJSON}
          </button>
          <button id="clear-data-btn" type="button" class="py-1.5 px-2 hover:text-rose-400 text-white/60 underline transition-colors min-h-[36px] flex items-center">
            {t.resetData}
          </button>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="px-6 py-3.5 bg-black/40 border-t border-white/[0.08] flex justify-end">
      <button
        id="dismiss-stats-btn"
        type="button"
        class="px-6 py-2.5 min-h-[40px] rounded-full bg-cyan-500 hover:bg-cyan-400 active:bg-cyan-600 text-black font-semibold text-xs transition-colors shadow-lg shadow-cyan-500/20"
      >
        {t.done}
      </button>
    </div>

  </div>
</div>
