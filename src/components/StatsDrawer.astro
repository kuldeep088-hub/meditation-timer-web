---
// StatsDrawer.astro - Apple Health-inspired mindful habit & streak dashboard
---

<div id="stats-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-200">
  <!-- Backdrop -->
  <div id="stats-backdrop" class="absolute inset-0 bg-black/40 dark:bg-black/60 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Container -->
  <div class="relative w-full max-w-lg max-h-[90vh] flex flex-col rounded-3xl bg-white dark:bg-[#1c1c1e] text-ink dark:text-white shadow-2xl border border-black/10 dark:border-white/10 overflow-hidden transform scale-95 transition-transform duration-200">
    
    <!-- Header -->
    <div class="px-6 py-4 flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08]">
      <div class="flex items-center gap-2">
        <span class="text-orange-500 text-lg">🔥</span>
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Mindfulness Stats</h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">100% private · Stored locally in your browser</p>
        </div>
      </div>
      <button
        id="close-stats-btn"
        type="button"
        class="w-7 h-7 rounded-full bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 flex items-center justify-center text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-white transition-colors"
        aria-label="Close stats"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="px-6 py-5 overflow-y-auto space-y-6">
      
      <!-- Top 4 Stats Metric Tiles -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <div class="bg-zinc-50 dark:bg-zinc-900/60 p-3.5 rounded-2xl border border-black/[0.04] dark:border-white/[0.04] text-center">
          <div id="stat-current-streak" class="text-2xl font-bold tracking-tight text-orange-500 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 mt-0.5">Day Streak</div>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/60 p-3.5 rounded-2xl border border-black/[0.04] dark:border-white/[0.04] text-center">
          <div id="stat-longest-streak" class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white tabular-nums">0</div>
          <div class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 mt-0.5">Best Streak</div>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/60 p-3.5 rounded-2xl border border-black/[0.04] dark:border-white/[0.04] text-center">
          <div id="stat-total-sessions" class="text-2xl font-bold tracking-tight text-blue-600 dark:text-blue-400 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 mt-0.5">Sessions</div>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/60 p-3.5 rounded-2xl border border-black/[0.04] dark:border-white/[0.04] text-center">
          <div id="stat-total-minutes" class="text-2xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400 tabular-nums">0</div>
          <div class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 mt-0.5">Minutes</div>
        </div>
      </div>

      <!-- 7-Day Activity Rhythm -->
      <div class="bg-zinc-50 dark:bg-zinc-900/60 p-4 rounded-2xl border border-black/[0.04] dark:border-white/[0.04]">
        <div class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 mb-3 flex items-center justify-between">
          <span>This Week's Mindful Rhythm</span>
          <span class="text-[11px] font-normal text-zinc-500">Last 7 Days</span>
        </div>
        <div id="week-dots-container" class="grid grid-cols-7 gap-2 text-center">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- Recent Sessions Log -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Recent Meditation Sessions</span>
          <span class="text-[11px] text-zinc-400" id="sessions-count-label">0 recorded</span>
        </div>

        <div id="recent-sessions-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
          <!-- Dynamically populated or empty state -->
          <div class="text-center py-6 text-zinc-400 text-xs">
            No completed sessions yet. Start your first practice today!
          </div>
        </div>
      </div>

      <!-- Privacy & Data Controls -->
      <div class="pt-3 border-t border-black/[0.06] dark:border-white/[0.08] flex items-center justify-between text-xs text-zinc-500">
        <span class="text-[11px]">No login required · No telemetry</span>
        <div class="flex gap-3">
          <button id="export-data-btn" type="button" class="hover:text-blue-600 dark:hover:text-blue-400 underline transition-colors">
            Export JSON
          </button>
          <button id="clear-data-btn" type="button" class="hover:text-red-600 dark:hover:text-red-400 underline transition-colors">
            Reset Data
          </button>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="px-6 py-3.5 bg-zinc-50 dark:bg-zinc-900 border-t border-black/[0.06] dark:border-white/[0.08] flex justify-end">
      <button
        id="dismiss-stats-btn"
        type="button"
        class="px-5 py-2 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs transition-colors shadow-xs"
      >
        Done
      </button>
    </div>

  </div>
</div>
