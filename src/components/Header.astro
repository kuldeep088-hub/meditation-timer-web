---
// Header.astro - Apple-style 44px frosted navigation bar with multi-language selector
import { languages, type SupportedLocale, translations } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
  cleanPath?: string;
}

const { lang = 'en', cleanPath = '/' } = Astro.props;
const t = translations[lang] || translations.en;

const langList = (Object.keys(languages) as SupportedLocale[]).map((code) => {
  const href = code === 'en'
    ? (cleanPath === '/' ? '/' : cleanPath)
    : (cleanPath === '/' ? `/${code}/` : `/${code}${cleanPath}`);
  return {
    code,
    ...languages[code],
    href,
  };
});
---

<header class="sticky top-0 z-40 w-full apple-glass border-b border-white/[0.08] transition-colors pt-[env(safe-area-inset-top,0px)]">
  <div class="max-w-5xl mx-auto px-3 sm:px-6 h-12 sm:h-11 flex items-center justify-between">
    <!-- Brand -->
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2 text-zinc-900 dark:text-white font-medium text-sm sm:text-[15px] tracking-tight hover:opacity-85 transition-opacity">
      <span class="w-7 h-7 sm:w-6 sm:h-6 rounded-full bg-blue-600 dark:bg-blue-500 flex items-center justify-center text-white shadow-xs shrink-0">
        <svg class="w-4 h-4 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
      </span>
      <span class="font-semibold truncate max-w-[115px] xs:max-w-[170px] sm:max-w-none text-xs sm:text-[15px]">{t.brand}</span>
    </a>

    <!-- Top Action Items -->
    <div class="flex items-center gap-1 sm:gap-2">
      <!-- Language Switcher Dropdown -->
      <div class="relative" id="lang-switcher-container">
        <button
          id="lang-menu-btn"
          type="button"
          class="flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 rounded-full text-xs font-semibold bg-white/10 hover:bg-white/15 active:bg-white/20 border border-white/10 shadow-2xs text-zinc-200 transition-all uppercase min-h-[36px] cursor-pointer touch-manipulation"
          aria-label="Select Language"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg class="w-3.5 h-3.5 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
            <path d="M2 12h20"/>
          </svg>
          <span class="text-[11px] font-bold">{lang}</span>
          <svg id="lang-arrow-icon" class="w-3 h-3 text-zinc-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div id="lang-dropdown-menu" class="absolute right-0 top-full mt-2 w-48 max-h-[70vh] overflow-y-auto rounded-2xl bg-[#1c1c1e] border border-white/[0.12] shadow-2xl py-1.5 hidden z-50 backdrop-blur-xl">
          {langList.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2.5 text-xs transition-colors rounded-xl mx-1 ${
                item.code === lang
                  ? 'bg-cyan-500/20 text-cyan-400 font-semibold border border-cyan-500/30'
                  : 'text-zinc-300 hover:bg-white/10 hover:text-white'
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-white/10 text-zinc-300 uppercase">{item.code}</span>
                <span class="font-medium">{item.nativeName}</span>
              </div>
              {item.code === lang && (
                <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Streak Badge Button -->
      <button
        id="streak-badge-btn"
        type="button"
        class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100/90 hover:bg-zinc-200/80 border border-zinc-200/80 shadow-2xs dark:bg-white/[0.08] dark:border-white/[0.08] dark:hover:bg-white/[0.14] text-zinc-800 dark:text-zinc-200 transition-all min-h-[36px] cursor-pointer touch-manipulation"
        title="View Mindful Stats & Streak"
      >
        <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500/20 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/>
        </svg>
        <span id="header-streak-count">0</span>
        <span class="hidden sm:inline text-zinc-500 dark:text-zinc-400">{t.dayStreak}</span>
      </button>

      <!-- Change Background / Wallpaper Button (like meditationtimer.online) -->
      <button
        id="open-bg-modal-btn"
        type="button"
        class="w-9 h-9 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-zinc-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer touch-manipulation"
        title="Change Background Wallpaper or Upload Photo"
        aria-label="Change Background"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <circle cx="9" cy="9" r="2"/>
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
      </button>

      <!-- Settings / Audio Mixer Button -->
      <button
        id="open-settings-btn"
        type="button"
        class="w-9 h-9 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-zinc-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer touch-manipulation"
        title="Audio, Bells & Interval Settings"
        aria-label="Settings"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>

      <!-- Fullscreen Toggle Button (Desktop/Tablet) -->
      <button
        id="fullscreen-toggle-btn"
        type="button"
        class="hidden sm:flex w-9 h-9 sm:w-8 sm:h-8 rounded-full items-center justify-center text-zinc-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer touch-manipulation"
        title="Toggle Fullscreen (F)"
        aria-label="Toggle Fullscreen"
      >
        <svg id="fullscreen-enter-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"/>
          <polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
        <svg id="fullscreen-exit-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 14 10 14 10 20"/>
          <polyline points="20 10 14 10 14 4"/>
          <line x1="14" y1="10" x2="21" y2="3"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<script>
  function setupLangDropdown() {
    const btn = document.getElementById('lang-menu-btn');
    const menu = document.getElementById('lang-dropdown-menu');
    const arrow = document.getElementById('lang-arrow-icon');
    const container = document.getElementById('lang-switcher-container');

    if (!btn || !menu) return;

    function openMenu() {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      arrow?.classList.add('rotate-180');
    }

    function closeMenu() {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      arrow?.classList.remove('rotate-180');
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!container?.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // Support hover on desktop devices
    container?.addEventListener('mouseenter', () => {
      if (window.matchMedia('(hover: hover)').matches) {
        openMenu();
      }
    });
    container?.addEventListener('mouseleave', () => {
      if (window.matchMedia('(hover: hover)').matches) {
        closeMenu();
      }
    });
  }

  // Run on initial load and navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLangDropdown);
  } else {
    setupLangDropdown();
  }
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>
