---
// Header.astro - Apple-style 44px frosted navigation bar with multi-language selector
import { languages, type SupportedLocale, translations } from '../i18n/translations';

interface Props {
  lang?: SupportedLocale;
  cleanPath?: string;
}

const { lang = 'en', cleanPath = '/' } = Astro.props;
const t = translations[lang] || translations.en;

const langList = (Object.keys(languages) as SupportedLocale[]).map((code) => {
  const prefix = code === 'en' ? '' : `/${code}`;
  const suffix = cleanPath === '/' ? (code === 'en' ? '/' : '') : cleanPath;
  const href = `${prefix}${suffix}` || '/';
  return {
    code,
    ...languages[code],
    href,
  };
});
---

<header class="sticky top-0 z-40 w-full apple-glass border-b border-zinc-200/80 dark:border-white/[0.08] transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-11 flex items-center justify-between">
    <!-- Brand -->
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2.5 text-zinc-900 dark:text-white font-medium text-[15px] tracking-tight hover:opacity-85 transition-opacity">
      <span class="w-6 h-6 rounded-full bg-blue-600 dark:bg-blue-500 flex items-center justify-center text-white shadow-xs">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
      </span>
      <span class="hidden sm:inline font-semibold">{t.brand}</span>
      <span class="sm:hidden font-semibold">{t.brand}</span>
    </a>

    <!-- Top Action Items -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Language Switcher Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100/90 hover:bg-zinc-200/80 border border-zinc-200/80 shadow-2xs dark:bg-white/[0.08] dark:border-white/[0.08] dark:hover:bg-white/[0.14] text-zinc-800 dark:text-zinc-200 transition-all uppercase"
          aria-label="Select Language"
        >
          <span>{languages[lang].flag}</span>
          <span class="text-[11px] font-bold">{lang}</span>
          <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute right-0 top-full mt-1.5 w-44 rounded-2xl bg-white dark:bg-[#1c1c1e] border border-zinc-200/80 dark:border-white/[0.1] shadow-xl py-1.5 hidden group-hover:block group-focus-within:block z-50">
          {langList.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2 text-xs transition-colors ${
                item.code === lang
                  ? 'bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 font-semibold'
                  : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'
              }`}
            >
              <div class="flex items-center gap-2">
                <span>{item.flag}</span>
                <span>{item.nativeName}</span>
              </div>
              {item.code === lang && <span class="text-blue-600 dark:text-blue-400 font-bold">✓</span>}
            </a>
          ))}
        </div>
      </div>

      <!-- Streak Badge Button -->
      <button
        id="streak-badge-btn"
        type="button"
        class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100/90 hover:bg-zinc-200/80 border border-zinc-200/80 shadow-2xs dark:bg-white/[0.08] dark:border-white/[0.08] dark:hover:bg-white/[0.14] text-zinc-800 dark:text-zinc-200 transition-all"
        title="View Mindful Stats & Streak"
      >
        <span class="text-orange-500 font-bold">🔥</span>
        <span id="header-streak-count">0</span>
        <span class="hidden sm:inline text-zinc-500 dark:text-zinc-400">{t.dayStreak}</span>
      </button>

      <!-- Settings / Audio Mixer Button -->
      <button
        id="open-settings-btn"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/[0.08] transition-colors"
        title="Audio, Bells & Interval Settings"
        aria-label="Settings"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>

      <!-- Fullscreen Toggle Button -->
      <button
        id="fullscreen-toggle-btn"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/[0.08] transition-colors"
        title="Toggle Fullscreen (F)"
        aria-label="Toggle Fullscreen"
      >
        <svg id="fullscreen-enter-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"/>
          <polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
        <svg id="fullscreen-exit-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 14 10 14 10 20"/>
          <polyline points="20 10 14 10 14 4"/>
          <line x1="14" y1="10" x2="21" y2="3"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
      </button>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-black/[0.04] dark:hover:bg-white/[0.08] transition-colors"
        title="Toggle Light / Dark Appearance"
        aria-label="Toggle Theme"
      >
        <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>
