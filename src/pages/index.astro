---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TimerApp from '../components/TimerApp.astro';
import QuickTimerLinks from '../components/QuickTimerLinks.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Meditation Timer Online | Free Minimalist Mindfulness Timer with Bells & Ambient Sounds"
  description="A serene, distraction-free online meditation timer. Features authentic Tibetan singing bowls, customizable warm-up, interval chimes, ambient nature sounds, screen wake lock, and zero ads."
  canonicalUrl="https://freemeditationtimeronline.com/"
>
  <Header />
  <main class="flex-1 flex flex-col">
    <TimerApp
      initialDurationSeconds={600}
      initialWarmupSeconds={10}
      initialBell="bowl"
      initialAmbient="none"
    />
    <QuickTimerLinks />
  </main>
  <Footer />
</Layout>
