---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import TimerApp from '../../components/TimerApp.astro';
import BeginnerGuide from '../../components/BeginnerGuide.astro';
import QuickTimerLinks from '../../components/QuickTimerLinks.astro';
import AiOverviewGuide from '../../components/AiOverviewGuide.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';
import { translations, type SupportedLocale } from '../../i18n/translations';

export function getStaticPaths() {
  const nonDefaultLocales: SupportedLocale[] = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'];

  const configs = [
    { slug: "1-minute-meditation-timer", seconds: 60, mins: 1 },
    { slug: "3-minute-meditation-timer", seconds: 180, mins: 3 },
    { slug: "5-minute-meditation-timer", seconds: 300, mins: 5 },
    { slug: "10-minute-meditation-timer", seconds: 600, mins: 10 },
    { slug: "15-minute-meditation-timer", seconds: 900, mins: 15 },
    { slug: "20-minute-meditation-timer", seconds: 1200, mins: 20 },
    { slug: "25-minute-meditation-timer", seconds: 1500, mins: 25 },
    { slug: "30-minute-meditation-timer", seconds: 1800, mins: 30 },
    { slug: "45-minute-meditation-timer", seconds: 2700, mins: 45 },
    { slug: "1-hour-meditation-timer", seconds: 3600, mins: 60 },
  ];

  const paths: any[] = [];
  for (const lang of nonDefaultLocales) {
    for (const cfg of configs) {
      paths.push({
        params: { lang, timer: cfg.slug },
        props: { ...cfg, lang },
      });
    }
  }

  return paths;
}

const { lang, slug, seconds, mins } = Astro.props as {
  lang: SupportedLocale;
  slug: string;
  seconds: number;
  mins: number;
};

const t = translations[lang] || translations.en;
const durationStr = t.minutesLabel(mins);
const pageHeading = `${durationStr} ${t.brand}`;
const pageDesc = `${pageHeading}: ${t.metaDescription}`;
---

<Layout
  title={`${pageHeading} | freemeditationtimeronline.com`}
  description={pageDesc}
  canonicalUrl={`https://freemeditationtimeronline.com/${lang}/${slug}`}
  lang={lang}
  cleanPath={`/${slug}`}
  durationSeconds={seconds}
>
  <Header lang={lang} cleanPath={`/${slug}`} />
  <main class="flex-1 flex flex-col">
    <!-- Preset Banner -->
    <div class="w-full max-w-xl mx-auto px-4 pt-6 text-center">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
        {pageHeading}
      </h1>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
        {t.quickTimersSubtitle}
      </p>
    </div>

    <!-- Timer Application -->
    <TimerApp
      lang={lang}
      initialDurationSeconds={seconds}
      initialWarmupSeconds={10}
      initialBell="bowl"
      initialAmbient="none"
      heading={pageHeading}
      subheading={t.metaDescription}
    />

    <!-- Mindful Practice Guidance Card -->
    {t.sessionTips && t.sessionTips[mins] && (
      <section class="max-w-2xl mx-auto px-4 py-8">
        <div class="p-6 rounded-2xl bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
                <path d="M9 18h6"/>
                <path d="M10 22h4"/>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-zinc-900 dark:text-white mb-1">
                {t.tipForSession}
              </h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {t.sessionTips[mins]}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Beginner's Guide & Tips -->
    <BeginnerGuide lang={lang} />

    <!-- Quick access to other durations -->
    <QuickTimerLinks lang={lang} />
    <AiOverviewGuide lang={lang} />
    <FAQ lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
