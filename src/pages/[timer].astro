---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TimerApp from '../components/TimerApp.astro';
import BeginnerGuide from '../components/BeginnerGuide.astro';
import QuickTimerLinks from '../components/QuickTimerLinks.astro';
import AiOverviewGuide from '../components/AiOverviewGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { translations } from '../i18n/translations';

export function getStaticPaths() {
  const configs = [
    {
      slug: "1-minute-meditation-timer",
      seconds: 60,
      title: "1 Minute Meditation Timer Online | Free Quick Mindful Reset",
      heading: "1 Minute Meditation Timer",
      subheading: "A 60-second micro-break to reset attention, release facial tension, and ground awareness in your breath.",
      tip: "Take three slow, conscious breaths. Inhale for 4 seconds, exhale for 4 seconds. Notice the immediate drop in cortisol."
    },
    {
      slug: "3-minute-meditation-timer",
      seconds: 180,
      title: "3 Minute Meditation Timer Online | Quick Mindful Breathing Break",
      heading: "3 Minute Meditation Timer",
      subheading: "Ideal for midday pauses between work meetings or settling anxiety during stressful moments.",
      tip: "Focus entirely on the physical sensations at the tip of your nostrils or the rising and falling of your abdomen."
    },
    {
      slug: "5-minute-meditation-timer",
      seconds: 300,
      title: "5 Minute Meditation Timer Online | Daily Mindfulness Practice",
      heading: "5 Minute Meditation Timer",
      subheading: "The golden standard for building a sustainable, unbreakable daily meditation habit.",
      tip: "Don't judge wandering thoughts. Each time you notice your mind drifting and gently return, you strengthen attentional circuits."
    },
    {
      slug: "10-minute-meditation-timer",
      seconds: 600,
      title: "10 Minute Meditation Timer Online | Classic Mindful Meditation",
      heading: "10 Minute Meditation Timer",
      subheading: "The quintessential meditation length scientifically proven to improve focus and downregulate emotional reactivity.",
      tip: "Allow your posture to be upright yet relaxed. Keep your chin slightly tucked and let your shoulders melt away from your ears."
    },
    {
      slug: "15-minute-meditation-timer",
      seconds: 900,
      title: "15 Minute Meditation Timer Online | Deep Calm & Stress Relief",
      heading: "15 Minute Meditation Timer",
      subheading: "Allows your nervous system to fully transition into the parasympathetic 'rest and digest' state.",
      tip: "Use the periodic interval bell in the settings if you like a gentle chime halfway through to refresh your presence."
    },
    {
      slug: "20-minute-meditation-timer",
      seconds: 1200,
      title: "20 Minute Meditation Timer Online | Deep Stillness & Insight",
      heading: "20 Minute Meditation Timer",
      subheading: "Standard duration for Transcendental Meditation (TM), Zen zazen, and Vipassana sits.",
      tip: "Observe sensations without reacting. Whatever arises — an itch, restlessness, warmth — simply welcome it with curiosity."
    },
    {
      slug: "25-minute-meditation-timer",
      seconds: 1500,
      title: "25 Minute Meditation Timer Online | Pomodoro & Mindfulness Sit",
      heading: "25 Minute Meditation Timer",
      subheading: "Perfect balance between standard work sprint integration and deep contemplation.",
      tip: "Treat the first 5 minutes as an invitation to arrive, the middle 15 as stabilization, and the final 5 as radiant stillness."
    },
    {
      slug: "30-minute-meditation-timer",
      seconds: 1800,
      title: "30 Minute Meditation Timer Online | Extended Mindful Practice",
      heading: "30 Minute Meditation Timer",
      subheading: "For seasoned meditators cultivating enduring tranquility, equanimity, and spaciousness.",
      tip: "Pay attention to the space between thoughts. In that silence lies profound clarity."
    },
    {
      slug: "45-minute-meditation-timer",
      seconds: 2700,
      title: "45 Minute Meditation Timer Online | Traditional Zazen & Insight Sit",
      heading: "45 Minute Meditation Timer",
      subheading: "The classic monastery sit length used in retreats worldwide.",
      tip: "Surrender effort. When sitting for 45 minutes, meditation ceases to be a task and becomes a natural state of being."
    },
    {
      slug: "1-hour-meditation-timer",
      seconds: 3600,
      title: "1 Hour Meditation Timer Online | Deep Retreat Practice",
      heading: "1 Hour Meditation Timer",
      subheading: "A full 60-minute immersive sit for weekend practice and dedicated mindfulness practitioners.",
      tip: "Ground yourself periodically in physical contact points — sit bones on the cushion, hands in your lap."
    },
  ];

  return configs.map(cfg => ({
    params: { timer: cfg.slug },
    props: { ...cfg },
  }));
}

const { slug, seconds, title, heading, subheading, tip } = Astro.props;
---

<Layout
  title={title}
  description={`${heading}: ${subheading} Free online meditation timer with authentic bells, screen wake lock, and no ads.`}
  canonicalUrl={`https://freemeditationtimeronline.com/${slug}`}
  lang="en"
  cleanPath={`/${slug}`}
  durationSeconds={seconds}
>
  <Header lang="en" cleanPath={`/${slug}`} />
  <main class="flex-1 flex flex-col">
    <!-- Preset Banner -->
    <div class="w-full max-w-xl mx-auto px-4 pt-6 text-center">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
        {heading}
      </h1>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
        {subheading}
      </p>
    </div>

    <!-- Timer Application -->
    <TimerApp
      lang="en"
      initialDurationSeconds={seconds}
      initialWarmupSeconds={10}
      initialBell="bowl"
      initialAmbient="none"
      heading={heading}
      subheading={subheading}
    />

    <!-- Mindful Practice Guidance Card -->
    <section class="max-w-2xl mx-auto px-4 py-8">
      <div class="p-6 rounded-2xl bg-white dark:bg-[#1c1c1e] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
              <path d="M9 18h6"/>
              <path d="M10 22h4"/>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-white mb-1">
              {translations.en.tipForSession}
            </h3>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {tip}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Beginner's Guide & Tips -->
    <BeginnerGuide lang="en" />

    <!-- Quick access to other durations -->
    <QuickTimerLinks lang="en" />
    <AiOverviewGuide lang="en" />
    <FAQ lang="en" />
  </main>
  <Footer lang="en" />
</Layout>
